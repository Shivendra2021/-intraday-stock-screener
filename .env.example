# ==============================================================================
# MarketMind Pro — Quant V4 Hybrid Research Environment Configuration
# All fields contain placeholder names only. Copy to .env and insert local keys.
# Never commit real API keys or credentials to version control.
# ==============================================================================

# ── Telegram Research Notifications ───────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# ── Primary Broker Data Provider: Angel One SmartAPI (Read-Only) ──────────────
ANGEL_ENABLED=True
ANGEL_API_KEY=your_smartapi_key_here
ANGEL_CLIENT_CODE=your_client_code_here
ANGEL_PIN=your_client_pin_here
ANGEL_TOTP_SECRET=your_totp_secret_here
ANGEL_BASE_URL=https://apiconnect.angelone.in
ANGEL_QUOTE_TIMEOUT_SECONDS=8
ANGEL_HISTORY_BATCH_DAYS=30

# ── Optional Secondary Providers (Read-Only Consensus) ────────────────────────
DHAN_CLIENT_ID=optional_dhan_client_id
DHAN_ACCESS_TOKEN=optional_dhan_access_token
ZERODHA_API_KEY=optional_zerodha_api_key
ZERODHA_ACCESS_TOKEN=optional_zerodha_access_token

# ── External Catalyst & Market Data APIs (Optional Read-Only) ─────────────────
SERPAPI_KEY=optional_serpapi_key_here
FINNHUB_API_KEY=optional_finnhub_key_here
FINNHUB_ENABLED=False
FRED_API_KEY=optional_fred_key_here
FRED_ENABLED=False
TWELVE_DATA_API_KEY=optional_twelve_data_key_here
TWELVE_DATA_ENABLED=False
NEWSAPI_KEY=optional_newsapi_key_here
THENEWSAPI_KEY=optional_thenewsapi_key_here
TAVILY_API_KEY=optional_tavily_key_here
CATALYST_SEARCH_ENABLED=False
CATALYST_MAX_DAILY_SEARCHES=8

# ── Post-Market AI Research Reviewers (Diagnostics Only — Never Orders) ───────
GEMINI_API_KEY=optional_gemini_api_key
GEMINI_MODEL=gemini-3.6-flash
GEMINI_AGENT_ENABLED=False

OPENROUTER_API_KEY=optional_openrouter_api_key
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_ENABLED=False

DASHSCOPE_API_KEY=optional_dashscope_api_key
QWEN_MAX_MODEL=qwen3.7-max

MISTRAL_API_KEY=optional_mistral_api_key
MISTRAL_MODEL=open-mistral-7b

GROQ_API_KEY=optional_groq_api_key
GROQ_DEEPSEEK_MODEL=qwen/qwen3.6-27b
GROQ_DEEPSEEK_ENABLED=False

OLLAMA_AGENT_ENABLED=False
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b

# ── Quant V4 Research Engine & Safeguards ─────────────────────────────────────
QUANT_ENABLED=True
QUANT_DB_PATH=data/quant.db
QUANT_WATCHLIST_SIZE=100
QUANT_MIN_DAILY_VALUE=20000000
QUANT_MIN_CIRCUIT_HEADROOM_PCT=2.0
QUANT_COST_BPS=20
QUANT_SLIPPAGE_BPS=5
QUANT_MIN_P7=0.30
QUANT_DASHBOARD_HOST=127.0.0.1

# ── Execution Modeling & Runner Targets (+7% / +10%) ──────────────────────────
RUNNER_BREAKEVEN_PCT=3.5
RUNNER_TP1_PCT=7.0
RUNNER_TP2_PCT=10.0
RUNNER_TRAIL_LOCKED_PCT=3.5

# ── Operational Controls ──────────────────────────────────────────────────────
DRY_RUN=False
AUTOMATION_SUPERVISOR_ENABLED=True
TERMINAL_UPDATER_ENABLED=True
HEAVY_JOB_LOCK_ENABLED=True
